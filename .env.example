# Brevo (Sendinblue) HTTP API configuration (HTTPS port 443 - Recommended for Railway)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=saakshi@vinayakafinancials.com
BREVO_SENDER_NAME=SAVI Enquiries

# Resend API configuration for outbound email (HTTPS port 443)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=SAVI Enquiries <onboarding@resend.dev>

# Database connection (auto-provided in Railway)
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Admin endpoint secret (used as ?key=... query param for GET /admin/submissions)
ADMIN_SECRET=change-this-to-a-long-random-string
