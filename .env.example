# Copy this file to .env and fill in real values. Never commit .env to git.

# SMTP configuration for outbound email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=SAVI Enquiries <noreply@vinayakafinancials.com>

# Admin endpoint secret (used as ?key=... query param for GET /admin/submissions)
ADMIN_SECRET=change-this-to-a-long-random-string
